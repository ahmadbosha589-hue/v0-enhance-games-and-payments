# ── Offerwall POSTBACK secrets (REQUIRED for the wall to credit users) ───────
# A wall with no secret here returns 403 on every postback → earnings never land.
CCXUA_SECRET_KEY=
CCXUA_ENFORCE_IP_WHITELIST=false
CPX_SECRET_KEY=
TOROX_SECRET_KEY=
