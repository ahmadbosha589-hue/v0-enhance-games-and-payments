# ─────────────────────────────────────────────────────────────────────────────
# Faucero — Environment Variables
# Copy to `.env.local` for development; set the same keys in your host dashboard
# (Vercel → Project → Settings → Environment Variables) for production, then
# redeploy. NEVER commit a real `.env.local` (it is git-ignored).
#
# Generated from every static `process.env.*` reference in `app/`, `components/`,
# `hooks/`, `lib/`, and `scripts/`, plus provider/admin configuration keys.
# REQUIRED values are checked by `npm run verify:launch`; optional provider
# values may remain blank and their feature stays unavailable (fails closed).
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
# Canonical public URL, no trailing slash. Used for postbacks, emails, OAuth.
NEXT_PUBLIC_APP_URL=https://www.faucero.com
# NODE_ENV is set automatically by Next.js; do not set it manually.
NODE_ENV=

# ── Supabase (REQUIRED) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Dev-only redirect for auth callbacks.
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=

# ── Security secrets (REQUIRED — generate 32-byte hex each) ──────────────────
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
CSRF_SECRET=
ENCRYPTION_KEY=
BALANCE_INTEGRITY_SECRET=
CHALLENGE_SECRET=
IP_HASH_SALT=

# ── Email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=

# ── Captcha (Cloudflare Turnstile) ───────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
HCAPTCHA_SECRET=

# ── Telegram bot (bot + Mini App + AdsGram ads) ──────────────────────────────
# From @BotFather. Blank = the bot and the rewarded-ad flow stay disabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Block id from https://partner.adsgram.ai — public placement identifier.
# Blank = rewarded-ad flow shows as unavailable (fails closed).
NEXT_PUBLIC_ADSGRAM_BLOCK_ID=

# ── Redis / KV (REQUIRED for rate-limited money operations; missing config fails closed) ──
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Payments: FaucetPay (REQUIRED for payouts) ───────────────────────────────
FAUCETPAY_API_KEY=
# Fallback manual deposit address shown if no provider is live.
BTC_DEPOSIT_ADDRESS=
NEXT_PUBLIC_BTC_DEPOSIT_ADDRESS=

# ── Payments: CCPayment (deposits / withdraw / swap) ─────────────────────────
CCPAYMENT_APP_ID=
CCPAYMENT_APP_SECRET=
CWALLET_API_KEY=

# ── Offerwall ad URLs (per wall; blank = wall renders "Setup Required") ──────
# c.cx.ua — featured wall; also the only one currently featured on /dashboard/offerwalls/ccxua
CCXUA_API_KEY=
NEXT_PUBLIC_CCXUA_API_KEY=
NEXT_PUBLIC_CCXUA_BANNER_ZONE_ID=
NEXT_PUBLIC_CCXUA_POPUP_ZONE_ID=
NEXT_PUBLIC_CCXUA_POPUP_PARAMS=
NEXT_PUBLIC_CXUA_BANNER_ZONE_ID=
NEXT_PUBLIC_CXUA_POPUP_ZONE_ID=
NEXT_PUBLIC_CXUA_POPUP_PARAMS=
# CPX Research
CPX_APP_ID=
NEXT_PUBLIC_CPX_APP_ID=
# Torox
TOROX_PUB_ID=
NEXT_PUBLIC_TOROX_PUB_ID=
# AdGate Media
ADGATE_WALL_CODE=
NEXT_PUBLIC_ADGATE_WALL_CODE=
# Lootably
LOOTABLY_PLACEMENT_ID=
NEXT_PUBLIC_LOOTABLY_PLACEMENT_ID=
# BitLabs
BITLABS_TOKEN=
NEXT_PUBLIC_BITLABS_TOKEN=
# Notik
NOTIK_PUB_ID=
# Timewall
TIMEWALL_KEY=
